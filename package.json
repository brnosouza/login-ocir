{
  "name": "@oracle-actions/login-ocir",
  "version": "1.3.0",
  "description": "GitHub Action to login to Oracle Cloud Infrastructure Registry (OCIR)",
  "author": {
    "name": "Oracle Cloud Infrastructure",
    "email": "oci-dax-tools_ww@oracle.com"
  },
  "private": true,
  "type": "module",
  "homepage": "https://github.com/oracle-actions/login-ocir#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oracle-actions/login-ocir.git"
  },
  "bugs": {
    "url": "https://github.com/oracle-actions/login-ocir/issues"
  },
  "keywords": [
    "actions",
    "cncf",
    "container-registry",
    "container",
    "distributions",
    "github",
    "oci",
    "oracle-cloud-infrastructure",
    "oracle-cloud",
    "registry"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "bundle": "bun run format:write && bun run package",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "package": "ncc build src/index.ts -o dist --source-map --license THIRD_PARTY_LICENSES.txt",
    "all": "bun run format:check && bun run lint && bun run typecheck && bun run package && bun run test",
    "test": "node --experimental-test-module-mocks --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "license": "UPL-1.0",
  "files": [
    "LICENSE.txt",
    "THIRD_PARTY_LICENSES.txt",
    "dist/*"
  ],
  "dependencies": {
    "@actions/core": "^3.0.1",
    "oci-artifacts": "^2.146.0",
    "oci-common": "^2.146.0",
    "oci-identity": "^2.146.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^9.39.5",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  }
}
